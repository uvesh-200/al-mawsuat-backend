FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY requirements.translation.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple

COPY translation_server.py /app/

EXPOSE 8002

CMD ["uvicorn", "translation_server:app", "--host", "0.0.0.0", "--port", "8002"]
