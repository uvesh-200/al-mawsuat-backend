MINIO_SECRET_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_BOOKS=books
MINIO_BUCKET_HIGHLIGHTS=highlights

# Messaging (Kafka)
