# Copy to `.env` and fill values. Do not commit real secrets.

# --- Core ---
DEFAULT_TENANT_ID= # Default tenant identifier used across the API.
ENVIRONMENT= # App environment name (development/staging/production).
LOG_LEVEL= # Logging verbosity (DEBUG/INFO/WARNING/ERROR).
SENTRY_DSN= # Sentry DSN for error reporting (optional).

# --- Database ---
DATABASE_URL= # SQLAlchemy database URL (asyncpg recommended for Postgres).
POSTGRES_USER= # Postgres user (used by docker compose postgres service).
POSTGRES_PASSWORD= # Postgres password (used by docker compose postgres service).
POSTGRES_DB= # Postgres database name (used by docker compose postgres service).

# --- Search / retrieval ---
QDRANT_HOST= # Qdrant host (vector database).
QDRANT_PORT= # Qdrant port (vector database).
MEILISEARCH_URL= # Meilisearch HTTP endpoint used by the app.
MEILISEARCH_KEY= # Meilisearch API key used by the app.
MEILI_MASTER_KEY= # Meilisearch master key used by the container at bootstrap.
REDIS_URL= # Redis connection URL.

# --- Storage (MinIO) ---
MINIO_ENDPOINT= # MinIO endpoint in host:port format.
MINIO_ACCESS_KEY= # MinIO access key used by the app SDK.
MINIO_SECRET_KEY= # MinIO secret key used by the app SDK.
MINIO_ROOT_USER= # MinIO root user used by the container at bootstrap.
MINIO_ROOT_PASSWORD= # MinIO root password used by the container at bootstrap.
MINIO_BUCKET_BOOKS= # Bucket name for original PDFs.
MINIO_BUCKET_HIGHLIGHTS= # Bucket name for highlight images.

# --- External APIs ---
GEMINI_API_KEY= # Google Gemini API key (for embeddings + OCR when OCR_ENGINE=gemini).
GEMINI_API_BASE= # Gemini API base URL (default: https://generativelanguage.googleapis.com).
GEMINI_OCR_MODEL= # Gemini model for OCR (default: gemini-2.0-flash).

OCR_ENGINE= # OCR engine: "tesseract" (default) or "gemini".
OCR_DPI= # DPI for page rendering during OCR (default: 200).
OCR_MAX_WORKERS= # Tesseract thread count, 0 = CPU count (default: 0).
OCR_RATE_LIMIT_RPM= # Gemini OCR requests per minute: 10 for free tier, 2000+ for paid (default: 10).
GROQ_API_KEY= # Groq API key (for LLM - gsk_...).
GROQ_BASE_URL= # Groq API base URL (default: https://api.groq.com/openai/v1).
GOOGLE_TRANSLATE_API_KEY= # Google Cloud Translation API key (optional, for non-Arabic queries).
GOOGLE_TRANSLATE_BASE_URL= # Google Translate API base URL.

# --- CORS ---
CORS_ORIGINS= # Comma-separated allowed origins (default: http://localhost:3000,http://localhost:3001).
CORS_ORIGIN_REGEX= # Regex for allowed origins (default: http://(localhost|192.168.\d+.\d+):\d+).

# --- Auth ---
JWT_SECRET_KEY= # Secret used to sign JWTs (required).
JWT_ALGORITHM= # JWT algorithm (e.g. HS256).
ACCESS_TOKEN_EXPIRE_MINUTES= # Access token expiry in minutes.
REFRESH_TOKEN_EXPIRE_DAYS= # Refresh token expiry in days.
