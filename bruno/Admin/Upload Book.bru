meta {
  name: Upload Book
  type: http
  seq: 1
}

post {
  url: {{base_url}}/admin/books/upload?title=Test+Book&author=Test+Author&language=ar&book_type=fiqh
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

body:multipart-form {
  file: @file(/path/to/book.pdf)
}
